# ==========================================================
# Student System AI — Environment Variables (Server-side only)
# لا تضع أي مفتاح من هذه القيم في كود المتصفح أو في NEXT_PUBLIC_*
# ==========================================================

# المزوّد الأساسي للنص والصوت. أسماء النماذج ثابتة داخل app/api/ai/route.ts.
GEMINI_API_KEY=

# المزوّد الاحتياطي لكل الوظائف؛ يستخدم Whisper لتفريغ الصوت ثم نموذج Groq النصي.
GROQ_API_KEY=

# مساعد تطوير الموقع + النشر التلقائي عبر GitHub
DEV_ASSISTANT_AUTO_APPLY=true
GITHUB_TOKEN=
GITHUB_OWNER=jj1333961-code
GITHUB_REPO=teacher
GITHUB_BRANCH=main
# اختياري: يشغّل النشر على Vercel بعد التعديل الناجح
VERCEL_DEPLOY_HOOK_URL=

# اختياري: مزوّد التحقق المتخصص من هوية المتحدث.
# عند عدم ضبطه لا يدّعي Groq إجراء تحقق بيومتري من التفريغ النصي.
SPEAKER_VERIFICATION_API_KEY=
SPEAKER_VERIFICATION_URL=

# Google OAuth (يُضبطان في Vercel؛ لا تضع السر في المتصفح)
# Authorized JavaScript origin: https://teacher-three-ashen.vercel.app
# Authorized redirect URI: https://teacher-three-ashen.vercel.app/api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
