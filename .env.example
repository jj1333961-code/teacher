# ==========================================================
# Student System AI — Environment Variables (Server-side only)
# لا تضع أي مفتاح من هذه القيم في كود المتصفح أو في NEXT_PUBLIC_*
# ==========================================================

# OpenRouter — مزود النص الأساسي المباشر
OPENROUTER_API_KEY=
# Groq — مزود احتياطي مباشر عند فشل OpenRouter
GROQ_API_KEY=
# اختياري: تخصيص النماذج الافتراضية
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# مساعد تطوير الموقع + النشر التلقائي عبر GitHub
DEV_ASSISTANT_AUTO_APPLY=true
GITHUB_TOKEN=
GITHUB_OWNER=jj1333961-code
GITHUB_REPO=student-system-ai
GITHUB_BRANCH=main
# اختياري: يشغّل النشر على Vercel بعد التعديل الناجح
VERCEL_DEPLOY_HOOK_URL=

# اختياري: مزوّد تحويل الصوت إلى نص (Speech-to-Text) متوافق مع OpenAI.
# عند ضبط المفتاح يُستخدم هذا المزوّد بدل OpenRouter تلقائياً.
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_URL=https://api.openai.com/v1/audio/transcriptions
SPEECH_TO_TEXT_MODEL=whisper-1

# اختياري: مزوّد التحقق من هوية المتحدث (Speaker Verification).
# نقطة توسعة — عند عدم ضبطه يستخدم النظام البصمة الصوتية المحلية.
SPEAKER_VERIFICATION_API_KEY=
SPEAKER_VERIFICATION_URL=
