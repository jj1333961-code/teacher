

 10 
وإذا أنجيناكم / نجيناكم  
يقتلون / يذبحون  
في البقرة {وإذ نجي اكم من آل فرعون يسومونكم سوء العذاب يذبحون أبناءكم ويستحيون نساءكم وفي ذلكم بلاء من ربكم عظيم} 
في الأعراف {وإذ أنجي اكم من آل فرعون يســـــــومونكم ســـــــوء العذاب  يقتلون أبناءكم ويســـــــتحيون نســـــــاءكم وفي ذلكم بلاء من ربكم 
عظيم} 
في إبراهيم  {وإذ قال موســـــــــــــى لقومه اذكروا نعمة الله عليكم إذ أنجاكم من آل فرعون يســـــــــــــومونكم ســـــــــــــوء العذاب  ويذبحون أبناءكم  
ويستحيون نساءكم وفي ذلكم بلاء من ربكم عظيم} 
• الضـــــــــــابط في هذا أن الذبب جاء في الســـــــــــورة التي أسماؤها فيها مناســـــــــــبة، فذبب البقرة، ورؤيا ذبب إبراهيم لابنه إسماعيل،  
فالذبب جاء في سورتي البقرة وإبراهيم. 
• ولفظ (أنجيناكم) بالهمز، جاء في السورة التي فيها همزة، وهي الأعراف، ولا يشكل لفظ (أنجاكم) في سورة إبراهيم. 
•  
ّ
كانفردت ســـــــورة إبراهيم بالواو (ويذبحون)؛ لأن الكلام جاء من موســـــــى لقومه، فكأنه يذر بني إســـــــرائيل بنعم الله عليهم، 
ويعددها، فعطف (بالواو)، أما باقي الآيات فهي امتنان مباشــر من الله تعالى على بني إســرائيل، بدون عطف على شــيء 
آخر. 
النبيين / الأنبياء  
بغير الحق / بغير حق 
في البقرة  {وضــربت عليهم الذلة والمســكنة وباءوا بغضــب من الله ذلك بأنهم كانوا يكفرون بآيات الله ويقتلون ال بيين  بغير الحق ذلك  
بما عصوا وكانوا يعتدون } 
في آل عمران {إن الذين يكفرون بآيات الله ويقتلون ال بيين  بغير حق ويقتلون الذين يأمرون بالقســـــــــــط من الناس فبشـــــــــــرهم بعذاب  
أليم} 
في آل عمران {ضـــــربت عليهم الذلة أين ما  قفوا إلا بحبل من الله وحبل من الناس وباءوا بغضـــــب من الله وضـــــربت عليهم المســـــكنة  
ذلك بأنهم كانوا يكفرون بآيات الله ويقتلون الأنبياء بغير حق ذلك بما عصوا وكانوا يعتدون} 
في آل عمران {لقد سمع الله قول الذين قالوا إن الله فقير ونحن أغنياء ســـــنكتب ما قالوا وقتلهم الأنبياء  بغير  حق  ونقول ذوقوا عذاب 
الحريق} 
في ال سعععععععععععاء  {فبما نقضــــــــــــــهم ميثاقهم وكفرهم بآيات الله وقتلهم الأنبياء بغير حق وقولهم قلوبنا غلف بل طبع الله عليها بكفرهم فلا 
يؤمنون إلا قليلا} 
لضبط هذه المواضع، يجب أن نعلم:  
• أن (النبيين) جمع مذكر سالم للفظ (نبي)، وهو يفيد القلة، و(الأنبياء) جمع تكسير لنفس اللفظ، لكنه يفيد الكثرة. 
• سورة البقرة امتازت بتعداد النعم على بني إسرائيل، فكان الذم فيها أقل من باقي السور. 
وإذا ضبطنا ذلك، سهل علينا التفريق بين المواضع بما يلي: 
• المواضــــع التي جاءت بالمبالغة في الذم لبني إســــرائيل، جاءت في غير البقرة، فجاء بلفظ (الأنبياء)، عدا الموضــــع الأول من 
آل عمران؛ لأنه لا يتحدر عن بني إســــرائيل، ولأنه أضــــاف لقتل الأنبياء، قتل المصــــلحين، فكأنه صــــار بذلك كثيرا، مع 
جمع القلة المستفاد من لفظ (النبيين). 
• الفرق بين (الحق) و (حق) أن التعريف يفيد أن القتل جاء بدون سبب من أسباب القتل، بينما التنكير يفيد أنه لا يوجد  
حق أصلا يبرر قتل الأنبياء، فكان الذم فيها أكثر، ولهذا جاءت كلمة (الحق) معرفة في البقرة فقط. 
• تستنتج من هذا أن الموضع في سورة البقرة {ويقتلون ال بيين بغير الحق ذلك} هو الأقل ذما. 
ولئن سألتهم من خلق 
في الع كبوت {ولئن سألتهم من خلق السماوات والأرض وسخر الشمس والقمر ليقولن الله فأنى يؤفكون} 
في لقمان {ولئن سألتهم من خلق السماوات والأرض ليقولن الله قل الحمد لله بل أكثرهم لا يعلمون} 
في الزمر {ولئن سألتهم من خلق السماوات والأرض ليقولن الله قل أفرأيتم ما تدعون من دون الله إن أرادني الله بضر} 
في الزخرف {ولئن سألتهم من خلق السماوات والأرض ليقولن خلقهن العزيز العليم} –الآية 9 
وفي الزخرف {ولئن سألتهم من خلقهم ليقولن الله فأنى يؤفكون}  –الآية 87 
• تنفرد الع كبوت بقوله {وسخر الشمس والقمر}، وتنفرد الآية الثانية من الزخرف بقوله {من خلقهم} 
