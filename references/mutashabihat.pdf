

 47 
وإذا قيل  
في البقرة  {وإذا قيـل لهم آم وا بمـا أنزل الله  قعالوا نؤمن بمعا أنزل علي عا ويكفرون بمـا وراءه وهو الحق مصــــــــــــــدقـا  لمـا معهم قـل فلم تقتلون 
أنبياء الله من قبل إن كنتم مؤمنين} - الآية: 91  
في  البقرة  {وإذا قيـل لهم  اتبعوا مـا أنزل الله  قعالوا بعل نتبع معا ألفي عا  عليـه آباءنا أولو كـان آباؤهم لا يعقلون  شــــــــــــــيئـا ولا يهتـدون }  - 
الآية: 170  
في المائدة  {وإذا قيل لهم تعالوا  إلى ما أنزل الله وإلى الرســول  قالوا حسععب ا ما وجدنا عليه آباءنا أولو كان آباؤهم  لا يعلمون شــيئا ولا 
يهتدون } 
في لقمان {وإذا قيل لهم  اتبعوا ما أنزل الله قالوا بل نتبع ما وجدنا عليه آباءنا أولو كان الشيطان يدعوهم إلى عذاب السعير} 
• ويلاحظ أه إذا جــاء الأمر  {اتبعوا}  كــان الجواب  {بــل نتبع} ،وإذا جــاء  {آمنوا}  كــان الجواب  {نؤمن بمــا}  ،وإذا جــاء 
{تعالوا} قالوا {حسبنا} 
• وترتيبها في الأمر الأول ،أنه في البقرة {آمنوا} {اتبعوا} وبعدها {تعالوا} {اتبعوا}  
يجري إلى أجل / لأجل  
في لقمان {كل يجري  إل أجل مسمى} وفي غيرها {كل يجري  لأجل  مسمى} 
ذلك بأن الله هو الحق  
في الحج {ذلك بأن الله  هو الحق وأن ما يدعون من دونه هو الباطل وأن الله هو العلي الكبير} 
وفي لقمان {ذلك بأن الله  هو الحق وأن ما يدعون من دونه الباطل وأن الله هو العلي الكبير}  
وهناك آية أخرى لكنه لا تشكل في الحج {ذلك بأن الله هو الحق وأنه يحيي الموتى وأنه على كل شيء قدير}  
 
سورة السجدة 
 
تتذكرون / تذكرون 
وردت  تتذكرون في  لار سور فقط ،وهي: 
1- الأنعام ،في قوله تعالى {وحاجة قومه .... أفلا تتذكرون} 
2- السجدة ،في قوله تعالى {الله الذي خلق السماوات والأرض وما بينهما ... أفلا تتذكرون} 
3- غافر ،في قوله تعالى {وما يستوي الأعمى والبصير والذين آمنوا وعملوا الصالحات ولا المسيء قليلا ما تتذكرون}  
• وباقي القرآن (تذكرون )  ،وقد جمعت السور الثلا ة في جملة (سجدت الأنعام للعافر) 
عذاب الخلد/ عذاب النار 
في يونس والسعععععجدة  في الموضـــــــع الأول  {عذاب الخلد} وفي غيرها  {عذاب ال ار}  ،والموضـــــــع الأول من الســـــــجدة هو {فذوقوا بما 
نســــــيتم لقاء يومكم هذا إنا نســــــيناكم وذوقوا عذاب الخلد  بما كنتم تعملون } ،والموضــــــع الثاني من الســــــجدة هو {وأما الذين فســــــقوا 
فمأواهم النار  ....وقيل لهم ذوقوا عذاب النار} 
يهدون بأمرنا / لما صبروا  
في الأنبياء {وجعلناهم أئمة يهدون بأمرنا وأوحينا إليهم فعل الخيرات وإقام الصلاة وإيتاء الزكاة وكانوا لنا عابدين}  
وفي السععععععععجدة  {وجعلنا منهم أئمة يهدون بأمرنا لما صععععععععبروا وكانوا بآياتنا يوقنون } وتنفرد السععععععععجدة  بقوله  {وجعلنا منهم} والباقي  
{وجعلناهم} 
أهلكنا (من) قبلهم  
في الأنعام والسجدة وص {أهلكنا من قبلهم} وفي غيرها {أهلكنا قبلهم} 
 
 
سورة سبأ 
 
يرزقكم من السماوات/السماء  
في سبأ {يرزقكم من السماوات والأرض} وفي غيرها {يرزقكم من السماء والأرض} 
